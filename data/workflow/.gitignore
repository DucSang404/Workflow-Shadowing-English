# secrets
.env

# TikTok app credentials + the rotating OAuth tokens. chmod 600.
# See CLAUDE.md, "Secrets" — this is a deliberate exception to the
# keys-live-only-in-n8n rule, and the reason is written down there.
secrets/*
# but keep the fill-in-the-blanks template in git
!secrets/tiktok.example.json

# n8n's own database volume
n8n_data/

# generated per-run artefacts
work/
output/

# music beds fetch_music.js downloaded from Openverse - regenerated on demand,
# and media does not belong in the repo. Files you put in assets/music/ yourself
# are NOT ignored.
assets/music/.openverse/

# deployed workflow snapshots are generated by host/deploy.js, but kept in git
# so workflow changes show up in diffs - nothing here is hand-edited

# python bytecode từ host/imagegen
__pycache__/
